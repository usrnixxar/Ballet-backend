PORT=4000
# Choose one admin data connection: Supabase private Edge bridge (recommended), or PostgreSQL.
BALLOT_ADMIN_BRIDGE_URL=https://YOUR-PROJECT.supabase.co/functions/v1/ballot-admin-bridge
BALLOT_ADMIN_BRIDGE_KEY=GENERATE_A_PRIVATE_RANDOM_KEY
SUPABASE_ANON_JWT=YOUR_PROJECT_LEGACY_ANON_JWT
# Optional alternative to the bridge, if you have a private Postgres connection:
DATABASE_URL=
FRONTEND_ORIGIN=https://YOUR-FRONTEND.vercel.app
ADMIN_ORIGIN=https://YOUR-ADMIN.vercel.app
API_PUBLIC_ORIGIN=https://YOUR-API.example.com
JWT_SECRET=GENERATE_A_LONG_RANDOM_64_CHARACTER_SECRET
ADMIN_EMAIL=admin@ballotpaper.in
ADMIN_PASSWORD=SET_A_STRONG_UNIQUE_PASSWORD
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NODE_ENV=production

# To enable audio upload straight from Admin Panel to ballet-paper-live:
# Fine-grained GitHub PAT; only repository usrnixxar/ballet-paper-live,
# permission Contents: Read and write. Configure only in private Vercel env.
BALLOT_GITHUB_CONTENTS_TOKEN=
